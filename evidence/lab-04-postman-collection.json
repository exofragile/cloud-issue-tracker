              "pm.test('Error shape with code VALIDATION_ERROR', function () { const b = pm.response.json(); pm.expect(b.error.code).to.eql('VALIDATION_ERROR'); pm.expect(b.error.message).to.be.a('string'); });",
              "pm.test('Title message comes first', function () { pm.expect(pm.response.json().error.message).to.include('Title'); });"
            ]
          }
        }
