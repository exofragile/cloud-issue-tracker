    {
      "name": "Create Issue with Server-Owned Fields",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Client-supplied server-owned fields ignored', function () { const b = pm.response.json(); pm.expect(b.id).to.not.eql('HACKED-1'); pm.expect(b.status).to.eql('Open'); pm.expect(b.createdAt).to.not.eql('2000-01-01T00:00:00.000Z'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/issues",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "issues"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"HACKED-1\",\n  \"title\": \"Projector flickering\",\n  \"description\": \"The projector in room B204 flickers.\",\n  \"priority\": \"Low\",\n  \"status\": \"Resolved\",\n  \"createdAt\": \"2000-01-01T00:00:00.000Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
