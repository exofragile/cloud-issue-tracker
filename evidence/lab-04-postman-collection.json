{
  "info": {
    "name": "Cloud Issue Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lab 4 tests for the Cloud Issue Tracker REST API. Run with the server started via npm run dev in backend/."
  },
  "item": [
    {
      "name": "View issues",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Body is a JSON array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
              "pm.test('Content-Type is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/issues",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "issues"
          ]
        }
      }
    },
    {
      "name": "Create issue",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "const issue = pm.response.json();",
              "pm.test('Server-generated id, status Open, createdAt present', function () { pm.expect(issue.id).to.be.a('string'); pm.expect(issue.status).to.eql('Open'); pm.expect(new Date(issue.createdAt).toISOString()).to.eql(issue.createdAt); });",
              "pm.collectionVariables.set('issueId', issue.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/issues",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "issues"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Printer unavailable\",\n  \"description\": \"The shared printer is not responding.\",\n  \"priority\": \"Medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Change issue status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Complete issue with status Resolved', function () { const b = pm.response.json(); pm.expect(b.status).to.eql('Resolved'); pm.expect(b.id).to.eql(pm.collectionVariables.get('issueId')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/issues/{{issueId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "issues",
            "{{issueId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
